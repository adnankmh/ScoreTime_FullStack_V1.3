APP_NAME="ScoreTime"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=football_global
DB_USERNAME=root
DB_PASSWORD=
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Licensed football provider. Keep API keys only on the Laravel server.
FOOTBALL_PROVIDER=demo
FOOTBALL_DATA_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_DATA_API_KEY=
FOOTBALL_SYNC_ENABLED=false
FOOTBALL_LIVE_SCHEDULER=false
FOOTBALL_CATALOG_SCHEDULER=false
FOOTBALL_CATALOG_SEASON=2026
FOOTBALL_LIVE_REFRESH_SECONDS=30
FOOTBALL_CACHE_SECONDS=60

PUSH_PROVIDER=firebase
FIREBASE_CREDENTIALS=
NOTIFICATION_CAMPAIGN_SCHEDULER=true

ADMIN_EMAIL=adnan@local.test
ADMIN_PASSWORD=Adnan123
ADMIN_REQUIRE_MFA=false
ADMIN_ALLOWED_IPS=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000

REALTIME_SSE_SLEEP_MS=1500
REALTIME_SSE_MAX_SECONDS=25
ADMIN_PRIMARY_USERNAME=Adnan
ADMIN_SUPERUSER_ONLY=true
