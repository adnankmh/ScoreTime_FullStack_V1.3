APP_NAME=ScoreTime
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
SCORETIME_SEED_DEMO_DATA=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=football_global
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=scoretime_session

CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:8000,https://adnankmh.github.io"

# ------------------------------------------------------------------
# ScoreTime football data
# "auto" selects API-Football when its key exists, then football-data,
# otherwise Preview/Demo.
# ------------------------------------------------------------------
FOOTBALL_PROVIDER=auto

# API-Football / API-Sports
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://v3.football.api-sports.io

# Free-plan protection. API-Football Free = 100 requests/day.
FOOTBALL_FREE_PLAN_MODE=true
FOOTBALL_FREE_DAILY_LIMIT=100
FOOTBALL_FREE_DAILY_RESERVE=20
FOOTBALL_FREE_LIVE_DAILY_CAP=40
FOOTBALL_FREE_DETAIL_DAILY_CAP=20
FOOTBALL_FREE_CATALOG_DAILY_CAP=8
FOOTBALL_FREE_LIVE_CRON="*/10 * * * *"
FOOTBALL_FREE_TODAY_CRON="5 0 * * *"
FOOTBALL_FREE_DETAIL_CRON="13,43 * * * *"
FOOTBALL_FREE_LIVE_WINDOW_BEFORE_MINUTES=210
FOOTBALL_FREE_LIVE_WINDOW_AFTER_MINUTES=20
FOOTBALL_FREE_DETAIL_CACHE_SECONDS=1800
FOOTBALL_CACHE_SECONDS=120

# Secondary free provider: football-data.org
FOOTBALL_DATA_ORG_KEY=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4

FOOTBALL_SYNC_ENABLED=false
FOOTBALL_LIVE_SCHEDULER=false
FOOTBALL_TODAY_SCHEDULER=false
FOOTBALL_CATALOG_SCHEDULER=false
FOOTBALL_CATALOG_SEASON=2026
FOOTBALL_FREE_CATALOG_PLAYER_PAGES=2
FOOTBALL_FEATURED_LEAGUES=39,140,135,78,61,2,3,1

# Optional news provider.
# NewsAPI Developer is intended for development/testing and has delayed
# articles, so it is NOT automatically enabled for public production.
NEWS_PROVIDER=newsapi
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2/
NEWS_QUERY="football OR soccer"
NEWS_LANGUAGES=en,ar,fr,es,de
NEWS_ALLOWED_DOMAINS=
NEWS_SYNC_SCHEDULER=false
NEWS_AUTO_PUBLISH=false

PUSH_PROVIDER=firebase
FIREBASE_CREDENTIALS=
NOTIFICATION_CAMPAIGN_SCHEDULER=true

# Bootstrap administrator. START_SCORETIME_WINDOWS generates a strong
# password locally when this is empty. Never commit a real password.
ADMIN_PRIMARY_USERNAME=Adnan
ADMIN_EMAIL=adnan@local.test
ADMIN_PASSWORD=
ADMIN_REQUIRE_MFA=false
ADMIN_SUPERUSER_ONLY=true
ADMIN_ALLOWED_IPS=

REALTIME_SSE_SLEEP_MS=1500
REALTIME_SSE_MAX_SECONDS=25
