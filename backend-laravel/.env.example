APP_NAME=ScoreTime
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=football_global
DB_USERNAME=root
DB_PASSWORD=

# Easy local defaults. Production may use Redis/database after deployment.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Licensed football data provider. Secrets stay on the Laravel server only.
FOOTBALL_DATA_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_CATALOG_SEASON=2026
FOOTBALL_LIVE_REFRESH_SECONDS=30
FOOTBALL_CACHE_SECONDS=60

PUSH_PROVIDER=firebase
FIREBASE_CREDENTIALS=
NOTIFICATION_CAMPAIGN_SCHEDULER=true

# Bootstrap administrator. CHANGE the password before production.
ADMIN_PRIMARY_USERNAME=Adnan
ADMIN_EMAIL=adnan@local.test
ADMIN_PASSWORD=Adnan123
ADMIN_REQUIRE_MFA=false
ADMIN_SUPERUSER_ONLY=true
ADMIN_ALLOWED_IPS=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,https://adnankmh.github.io
REALTIME_SSE_SLEEP_MS=1500
REALTIME_SSE_MAX_SECONDS=25


# ScoreTime Live Global Data
FOOTBALL_PROVIDER=demo
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_DATA_ORG_KEY=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4
FOOTBALL_SYNC_ENABLED=false
FOOTBALL_LIVE_SCHEDULER=false
FOOTBALL_TODAY_SCHEDULER=false
FOOTBALL_CATALOG_SCHEDULER=false
FOOTBALL_LIVE_REFRESH_SECONDS=30
FOOTBALL_FEATURED_LEAGUES=39,140,135,78,61,2,3,1

NEWS_PROVIDER=newsapi
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2/
NEWS_QUERY=football OR soccer
NEWS_LANGUAGES=en,ar,fr,es,de
NEWS_ALLOWED_DOMAINS=
NEWS_SYNC_SCHEDULER=false
NEWS_AUTO_PUBLISH=true
